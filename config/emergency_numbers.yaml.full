crisis_by_country:
  US:
    verified: true
    lines:
    - 988 Suicide & Crisis Lifeline — call or text 988
    - Domestic Violence 1-800-799-7233
    - Sexual Assault (RAINN) 1-800-656-4673
  CA:
    verified: true
    lines:
    - 988 Suicide Crisis Helpline — call or text 988
    - 211 community & social services
  GB:
    verified: true
    lines:
    - Samaritans 116 123
    - NHS non-emergency 111
  IE:
    verified: true
    lines:
    - Samaritans 116 123
  AU:
    verified: true
    lines:
