# Python
__pycache__/
*.pyc
.DS_Store

# Large / regenerable model + enrichment artifacts (NOT the gold seed, which is
# expensive to regenerate and kept under version control)
enrichment/data/*-lora/
enrichment/data/gemma4-enrich-lora/
enrichment/data/enriched*.parquet
enrichment/data/*.f32
*.safetensors

# V1 API build artifacts (rebuildable from KB)
api/data/*.parquet
api/data/memory/
api/data/traces.jsonl
eval/last_results.json

# V2 DPO data — LoRA adapters + regenerable sample pairs (real gold pairs, if
# generated, should be force-added like enrichment/data/gold.jsonl).
v2/data/*-lora/
v2/data/pairs_sample.jsonl
# Merged bf16 model (~49 GB): regenerable in ~10 min via `serve_vllm merge`. Its small
# JSON files were slipping past the *-lora/ rule and getting committed.
v2/data/gemma4-v2-merged/
v2/data/*-4bit/
# Server run log — working state, not an artifact.
server.log
# Derived pair sets: trivially rebuilt from the API-generated sources (pairs.jsonl,
# pairs_gujarati.jsonl) by `cat`, or regenerated on GPU. 16-51MB each.
v2/data/pairs_bilingual*.jsonl
v2/data/pairs_v2*.jsonl
v2/data/pairs_onpolicy.jsonl
# Offline translation cache for the shastrarth experiment (regenerable, API-cheap).
eval/.translation_cache.json
# Eval resume sidecars + run logs: working state, not results. The scored results live
# in the committed eval/*.json files; a sidecar is only meaningful mid-run.
eval/*.partial.jsonl
eval/*.log
enrichment/data/audit_bad_ids.txt
docker-compose env
.env

# Session signing key — must never be committed; a leaked key forges any cookie.
api/data/.session_secret
